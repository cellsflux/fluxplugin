  },
  "license": "MIT",
  "icon": "./assets/icon.svg",
  "readme": "./README.md",
  "categories": [
    "Productivity",
    "UI"
  ],
  "keywords": [
    "dashboard",
    "widget",
    "toolbar"
  ],
  "links": {
    "docs": "https://www.npmjs.com/package/fluxplugin"
  },
  "video": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
}